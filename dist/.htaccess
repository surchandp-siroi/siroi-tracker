<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Strip trailing slash from non-directory URLs (e.g. /login/ -> /login)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [L,R=301]

  # 2. Existing files and directories serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Permanently redirect old SVG favicon requests to the new PNG icon
  RewriteRule ^(.*)favicon\.svg$ /favicon.png [L,R=301]

  # 4. Route subfolder favicon requests to root favicon files
  RewriteRule ^(.*)favicon\.(ico|png)$ favicon.$2 [L]

  # 5. Route everything else to index.html for SPA
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Aggressive Cache Prevention (Ensure site does not load on any cache ever)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # 1. HTML documents must NEVER be cached
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </FilesMatch>

  # 2. JSON & version manifests must NEVER be cached
  <FilesMatch "\.(json|xml)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 3. Favicon immediate revalidation
  <FilesMatch "favicon\.(ico|png|svg)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Disable ETags to avoid 304 Not Modified when fresh code is deployed
  Header unset ETag
  FileETag None
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
